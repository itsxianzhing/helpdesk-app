<file path="Data/Interceptors/AuditSaveChangesInterceptor.cs">
 1: using Helpdesk.Models.Base;
 2: using Helpdesk.Services;
 3: using Microsoft.EntityFrameworkCore;
 4: using Microsoft.EntityFrameworkCore.Diagnostics;
 5:
 6: namespace Helpdesk.Data.Interceptors;
 7:
 8: public class AuditSaveChangesInterceptor : SaveChangesInterceptor
 9: {
10:     private readonly ICurrentUserAccessor _currentUser;
11:
12:     public AuditSaveChangesInterceptor(
13:         ICurrentUserAccessor currentUser)
14:     {
15:         _currentUser = currentUser;
16:     }
17:
18:     public override InterceptionResult<int> SavingChanges(
19:         DbContextEventData eventData,
20:         InterceptionResult<int> result)
21:     {
22:         UpdateAuditFields(eventData.Context);
23:
24:         return base.SavingChanges(eventData, result);
25:     }
26:
27:     public override ValueTask<InterceptionResult<int>> SavingChangesAsync(
28:         DbContextEventData eventData,
29:         InterceptionResult<int> result,
30:         CancellationToken cancellationToken = default)
31:     {
32:         UpdateAuditFields(eventData.Context);
33:
34:         return base.SavingChangesAsync(
35:             eventData,
36:             result,
37:             cancellationToken);
38:     }
39:
40:     private void UpdateAuditFields(DbContext? context)
41:     {
42:         if (context == null)
43:             return;
44:
45:         var utcNow = DateTime.UtcNow;
46:
47:         foreach (var entry in context.ChangeTracker
48:             .Entries<BaseEntity>())
49:         {
50:             switch (entry.State)
51:             {
52:                 case EntityState.Added:
53:
54:                     entry.Entity.CreatedAt = utcNow;
55:                     entry.Entity.CreatedBy = _currentUser.UserId;
56:
57:                     break;
58:
59:                 case EntityState.Modified:
60:
61:                     entry.Property(e => e.CreatedAt)
62:                         .IsModified = false;
63:
64:                     entry.Property(e => e.CreatedBy)
65:                         .IsModified = false;
66:
67:                     entry.Entity.UpdatedAt = utcNow;
68:                     entry.Entity.UpdatedBy = _currentUser.UserId;
69:
70:                     break;
71:             }
72:         }
73:     }
74: }
</file>

<file path="Data/AppDbContext.cs">
  1: using Helpdesk.Models;
  2: using Helpdesk.Services;
  3: using Helpdesk.Models.Base;
  4: using Microsoft.EntityFrameworkCore;
  5:
  6: namespace Helpdesk.Data;
  7:
  8: public class AppDbContext : DbContext
  9: {
 10:     public AppDbContext(
 11:         DbContextOptions<AppDbContext> options)
 12:         : base(options)
 13:     {
 14:     }
 15:
 16:     public DbSet<User> Users => Set<User>();
 17:     public DbSet<Ticket> Tickets => Set<Ticket>();
 18:     public DbSet<Comment> Comments => Set<Comment>();
 19:     public DbSet<ActivityLog> ActivityLogs => Set<ActivityLog>();
 20:
 21:     protected override void OnModelCreating(ModelBuilder modelBuilder)
 22:     {
 23:         modelBuilder.ApplyConfigurationsFromAssembly(
 24:             typeof(AppDbContext).Assembly);
 25:
 26:         // =========================
 27:         // Enum To String
 28:         // =========================
 29:
 30:         modelBuilder.Entity<User>()
 31:         .Property(u => u.Role)
 32:         .HasConversion<string>();
 33:
 34:         modelBuilder.Entity<User>()
 35:             .Property(u => u.Status)
 36:             .HasConversion<string>();
 37:
 38:         modelBuilder.Entity<Ticket>()
 39:             .Property(t => t.Status)
 40:             .HasConversion<string>();
 41:
 42:         modelBuilder.Entity<Ticket>()
 43:             .Property(t => t.Priority)
 44:             .HasConversion<string>();
 45:
 46:         // =========================
 47:         // Unique Index
 48:         // =========================
 49:
 50:         modelBuilder.Entity<Ticket>()
 51:             .HasIndex(t => t.TicketNumber)
 52:             .IsUnique();
 53:
 54:         // =========================
 55:         // Optimistic Concurrency
 56:         // =========================
 57:
 58:         modelBuilder.Entity<User>()
 59:             .Property(u => u.Version)
 60:             .IsRowVersion();
 61:
 62:         modelBuilder.Entity<Ticket>()
 63:             .Property(t => t.Version)
 64:             .IsRowVersion();
 65:
 66:         modelBuilder.Entity<Comment>()
 67:             .Property(c => c.Version)
 68:             .IsRowVersion();
 69:
 70:         // =========================
 71:         // Audit Fields
 72:         // =========================
 73:
 74:         modelBuilder.Entity<User>()
 75:             .Property(u => u.CreatedAt)
 76:             .HasDefaultValueSql("CURRENT_TIMESTAMP");
 77:
 78:         modelBuilder.Entity<Ticket>()
 79:             .Property(t => t.CreatedAt)
 80:             .HasDefaultValueSql("CURRENT_TIMESTAMP");
 81:
 82:         modelBuilder.Entity<Comment>()
 83:             .Property(c => c.CreatedAt)
 84:             .HasDefaultValueSql("CURRENT_TIMESTAMP");
 85:
 86:         // =========================
 87:         // Soft Delete
 88:         // =========================
 89:
 90:         modelBuilder.Entity<User>()
 91:             .HasQueryFilter(u => u.DeletedAt == null);
 92:
 93:         modelBuilder.Entity<Ticket>()
 94:             .HasQueryFilter(t => t.DeletedAt == null);
 95:
 96:         modelBuilder.Entity<Comment>()
 97:             .HasQueryFilter(c => c.DeletedAt == null);
 98:
 99:         base.OnModelCreating(modelBuilder);
100:     }
101: }
</file>

