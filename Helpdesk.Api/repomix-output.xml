126:         return request.SortBy switch
127:         {
128:             UserSortBy.Name => request.Descending
129:                 ? query.OrderByDescending(u => u.Name)
130:                 : query.OrderBy(u => u.Name),
131:
132:             UserSortBy.Email => request.Descending
133:                 ? query.OrderByDescending(u => u.Email)
