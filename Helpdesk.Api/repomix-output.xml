 46:         Type = SecuritySchemeType.Http,
 47:         Scheme = "bearer",
 48:         BearerFormat = "JWT",
 49:         In = ParameterLocation.Header,
 50:         Description = "Masukkan JWT tanpa kata Bearer."
 51:     });
 52:
 53:     options.AddSecurityRequirement(document => new OpenApiSecurityRequirement
 54:     {
 55:         [new OpenApiSecuritySchemeReference("Bearer", document)] = new List<string>()
 56:     });
 57: });
 58:
 59: builder.Services.AddAuthentication(JwtBearerDefaults.AuthenticationScheme)
 60:     .AddJwtBearer(options =>
 61:     {
 62:         options.TokenValidationParameters = new TokenValidationParameters
 63:         {
 64:             ValidateIssuer = true,
 65:             ValidateAudience = true,
 66:             ValidateLifetime = true,
 67:             ValidateIssuerSigningKey = true,
 68:
 69:             ValidIssuer = builder.Configuration["Jwt:Issuer"],
 70:             ValidAudience = builder.Configuration["Jwt:Audience"],
 71:
 72:             IssuerSigningKey = new SymmetricSecurityKey(
 73:                 Encoding.UTF8.GetBytes(builder.Configuration["Jwt:Key"]!))
 74:         };
 75:
 76:         options.Events = new JwtBearerEvents
 77:         {
 78:             OnChallenge = async context =>
 79:             {
 80:                 context.HandleResponse();
 81:
 82:                 context.Response.StatusCode = StatusCodes.Status401Unauthorized;
 83:                 context.Response.ContentType = "application/json";
 84:
 85:                 await context.Response.WriteAsJsonAsync(new
 86:                 {
 87:                     message = "Unauthorized."
 88:                 });
 89:             },
 90:
 91:             OnForbidden = async context =>
 92:             {
 93:                 context.Response.StatusCode = StatusCodes.Status403Forbidden;
 94:                 context.Response.ContentType = "application/json";
 95:
 96:                 await context.Response.WriteAsJsonAsync(new
 97:                 {
 98:                     message = "Access denied."
 99:                 });
100:             }
101:         };
102:     });
103:
104: builder.Services.AddAuthorization();
105: builder.Services.AddHttpContextAccessor();
106:
107: builder.Services.AddScoped<ICurrentUserAccessor, CurrentUserAccessor>();
108: builder.Services.AddScoped<CurrentUserService>();
109: builder.Services.AddScoped<AuthService>();
110: builder.Services.AddScoped<JwtService>();
111: builder.Services.AddScoped<UserService>();
112: builder.Services.AddScoped<TicketService>();
113: builder.Services.AddScoped<CommentService>();
114: builder.Services.AddScoped<ActivityLogService>();
115:
116: builder.Services.AddScoped<AuditSaveChangesInterceptor>();
117:
118: builder.Services.AddDbContext<AppDbContext>((serviceProvider, options) =>
119: {
120:     options.UseNpgsql(
121:         builder.Configuration.GetConnectionString("DefaultConnection"));
122:
123:     options.AddInterceptors(
124:         serviceProvider.GetRequiredService<AuditSaveChangesInterceptor>());
125: });
126:
127: var app = builder.Build();
128:
129: if (app.Environment.IsDevelopment())
130: {
131:     app.UseSwagger();
132:
133:     app.MapScalarApiReference(options =>
134:     {
135:         options
136:             .WithTitle("Helpdesk API")
137:             .WithOpenApiRoutePattern("/swagger/{documentName}/swagger.json");
138:     });
139: }
140:
141: using (var scope = app.Services.CreateScope())
142: {
143:     var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
144:
145:     await db.Database.MigrateAsync();
146: }
147:
148: app.UseExceptionMiddleware();
149:
150: app.UseAuthentication();
151: app.UseAuthorization();
152:
153: app.MapControllers();
