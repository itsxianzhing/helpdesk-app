 1: using BCrypt.Net;
 2: using Helpdesk.Data;
 3: using Helpdesk.Dtos.Auth;
 4: using Helpdesk.Models;
 5: using Helpdesk.Exceptions;
 6: using Microsoft.EntityFrameworkCore;
 7:
 8: namespace Helpdesk.Services;
 9:
10: public class AuthService
11: {
12:     private readonly AppDbContext _context;
13:     private readonly JwtService _jwtService;
14:
15:     public AuthService(
16:         AppDbContext context,
17:         JwtService jwtService)
18:     {
19:         _context = context;
20:         _jwtService = jwtService;
21:     }
22:
23:     public async Task<AuthResponse> Login(
24:         LoginRequest request,
25:         CancellationToken cancellationToken)
26:     {
27:         var user = await _context.Users
28:             .AsNoTracking()
29:             .FirstOrDefaultAsync(
30:                 u =>
31:                     u.Email == request.Email &&
32:                     u.Status == UserStatus.Active,
33:                 cancellationToken);
34:
35:         if (user == null)
36:             throw new UnauthorizedException(
37:                 "Invalid email or password.");
38:
39:         var validPassword = BCrypt.Net.BCrypt.Verify(
40:             request.Password,
41:             user.PasswordHash);
42:
43:         if (!validPassword)
44:             throw new UnauthorizedException(
45:                 "Invalid email or password.");
46:
47:         var token = _jwtService.GenerateToken(user);
48:
49:         return new AuthResponse
50:         {
51:             Token = token,
52:             Id = user.Id,
53:             Name = user.Name,
54:             Email = user.Email,
55:             Role = user.Role.ToString()
56:         };
57:     }
58: }
