 19:         ActivityLogService activityLogService)
 20:         : base(context, currentUserService)
 21:     {
 22:         _activityLogService = activityLogService;
 23:     }
 24:
 25:     private async Task<Ticket> GetTicketOrThrow(
 26:         int id,
 27:         bool tracking = true,
 28:         CancellationToken cancellationToken = default)
 29:     {
 30:         IQueryable<Ticket> query = tracking
 31:             ? Context.Tickets
 32:             : Context.Tickets.AsNoTracking();
 33:
 34:         var ticket = await query.FirstOrDefaultAsync(
 35:             t => t.Id == id,
 36:             cancellationToken);
 37:
 38:         if (ticket == null)
 39:             throw new NotFoundException("Ticket not found.");
 40:
 41:         return ticket;
 42:     }
 43:
 44:     private async Task<Comment> GetCommentOrThrow(
 45:         int id,
 46:         bool tracking = true,
 47:         bool includeUser = false,
 48:         CancellationToken cancellationToken = default)
 49:     {
 50:         IQueryable<Comment> query = tracking
 51:             ? Context.Comments
 52:             : Context.Comments.AsNoTracking();
 53:
 54:         if (includeUser)
 55:         {
 56:             query = query.Include(c => c.User);
 57:         }
 58:
 59:         var comment = await query.FirstOrDefaultAsync(
 60:             c => c.Id == id,
 61:             cancellationToken);
 62:
 63:         if (comment == null)
 64:             throw new NotFoundException("Comment not found.");
 65:
 66:         return comment;
 67:     }
 68:
 69:     public async Task<List<CommentResponse>> GetByTicketId(
 70:         int ticketId,
 71:         CancellationToken cancellationToken)
 72:     {
 73:         var ticket = await GetTicketOrThrow(
 74:             ticketId,
 75:             tracking: false,
 76:             cancellationToken: cancellationToken);
 77:
 78:         var currentUser = await GetCurrentUser(
 79:             cancellationToken);
 80:
 81:         AuthorizationHelper.EnsureOwnerOrAdmin(
 82:             ticket.UserId,
 83:             currentUser);
 84:
 85:         return await Context.Comments
 86:             .AsNoTracking()
 87:             .Where(c => c.TicketId == ticketId)
 88:             .OrderBy(c => c.CreatedAt)
 89:             .Select(CommentMapper.ToCommentResponseProjection)
 90:             .ToListAsync(cancellationToken);
 91:     }
 92:
 93:     public async Task<CommentResponse> Create(
 94:         int ticketId,
 95:         CreateCommentRequest request,
 96:         CancellationToken cancellationToken)
 97:     {
 98:         await using var transaction =
 99:             await Context.Database.BeginTransactionAsync(
100:                 cancellationToken);
101:
102:         try
103:         {
104:             var ticket = await GetTicketOrThrow(
105:                 ticketId,
106:                 cancellationToken: cancellationToken);
107:
108:             var currentUser = await GetCurrentUser(
109:                 cancellationToken);
110:
111:             AuthorizationHelper.EnsureOwnerOrAdmin(
112:                 ticket.UserId,
113:                 currentUser);
114:
115:             var comment = new Comment
116:             {
117:                 Content = request.Content.Trim(),
118:                 TicketId = ticketId,
119:                 UserId = currentUser.Id,
120:                 User = currentUser
121:             };
122:
123:             Context.Comments.Add(comment);
124:
125:             await Context.SaveChangesAsync(
126:                 cancellationToken);
127:
128:             _activityLogService.Add(
129:                 action: "Create",
130:                 entityType: "Comment",
131:                 entityId: comment.Id,
132:                 description: $"Created comment on ticket {ticket.TicketNumber}");
133:
134:             await Context.SaveChangesAsync(
135:                 cancellationToken);
136:
137:             await transaction.CommitAsync(
138:                 cancellationToken);
139:
140:             return CommentMapper.ToCommentResponse(comment);
141:         }
142:         catch
143:         {
144:             await transaction.RollbackAsync(
145:                 cancellationToken);
146:
147:             throw;
148:         }
149:     }
