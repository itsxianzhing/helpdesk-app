<file path="Extensions/QueryableExtensions.cs">
  1: using Helpdesk.Models;
  2: using Helpdesk.Dtos.Ticket;
  3: using Helpdesk.Dtos.User;
  4: using Microsoft.EntityFrameworkCore;
  5:
  6: namespace Helpdesk.Extensions;
  7:
  8: public static class QueryableExtensions
  9: {
 10:     public static IQueryable<T> ApplyPagination<T>(
 11:         this IQueryable<T> query,
 12:         int page,
 13:         int pageSize)
 14:     {
 15:         return query
 16:             .Skip((page - 1) * pageSize)
 17:             .Take(pageSize);
 18:     }
 19:
 20:     // =========================
 21:     // Ticket
 22:     // =========================
 23:
 24:     public static IQueryable<Ticket> ApplyFilters(
 25:         this IQueryable<Ticket> query,
 26:         TicketQueryRequest request)
 27:     {
 28:         if (!string.IsNullOrWhiteSpace(request.Search))
 29:         {
 30:             var keyword = request.Search.Trim();
 31:
 32:             query = query.Where(t =>
 33:                 EF.Functions.ILike(
 34:                     t.Title,
 35:                     $"%{keyword}%") ||
 36:
 37:                 EF.Functions.ILike(
 38:                     t.Description,
 39:                     $"%{keyword}%"));
 40:         }
 41:
 42:         if (request.Status.HasValue)
 43:         {
 44:             query = query.Where(t =>
 45:                 t.Status == request.Status.Value);
 46:         }
 47:
 48:         if (request.Priority.HasValue)
 49:         {
 50:             query = query.Where(t =>
 51:                 t.Priority == request.Priority.Value);
 52:         }
 53:
 54:         return query;
 55:     }
 56:
 57:     public static IQueryable<Ticket> ApplySorting(
 58:         this IQueryable<Ticket> query,
 59:         TicketQueryRequest request)
 60:     {
 61:         return request.SortBy switch
 62:         {
 63:             TicketSortBy.Title => request.Descending
 64:                 ? query.OrderByDescending(t => t.Title)
 65:                 : query.OrderBy(t => t.Title),
 66:
 67:             TicketSortBy.Priority => request.Descending
 68:                 ? query.OrderByDescending(t => t.Priority)
 69:                 : query.OrderBy(t => t.Priority),
 70:
 71:             TicketSortBy.Status => request.Descending
 72:                 ? query.OrderByDescending(t => t.Status)
 73:                 : query.OrderBy(t => t.Status),
 74:
 75:             TicketSortBy.CreatedAt => request.Descending
 76:                 ? query.OrderByDescending(t => t.CreatedAt)
 77:                 : query.OrderBy(t => t.CreatedAt),
 78:
 79:             _ => request.Descending
 80:                 ? query.OrderByDescending(t => t.CreatedAt)
 81:                 : query.OrderBy(t => t.CreatedAt)
 82:         };
 83:     }
 84:
 85:     // =========================
 86:     // User
 87:     // =========================
 88:
 89:     public static IQueryable<User> ApplyFilters(
 90:         this IQueryable<User> query,
 91:         UserQueryRequest request)
 92:     {
 93:         if (!string.IsNullOrWhiteSpace(request.Search))
 94:         {
 95:             var keyword = request.Search.Trim();
 96:
 97:             query = query.Where(u =>
 98:                 EF.Functions.ILike(
 99:                     u.Name,
100:                     $"%{keyword}%") ||
101:
102:                 EF.Functions.ILike(
103:                     u.Email,
104:                     $"%{keyword}%"));
105:         }
106:
107:         if (request.Role.HasValue)
108:         {
109:             query = query.Where(u =>
110:                 u.Role == request.Role.Value);
111:         }
112:
113:         if (request.Status.HasValue)
114:         {
115:             query = query.Where(u =>
116:                 u.Status == request.Status.Value);
117:         }
118:
119:         return query;
120:     }
121:
122:     public static IQueryable<User> ApplySorting(
123:         this IQueryable<User> query,
124:         UserQueryRequest request)
