151:     public async Task<CommentResponse> Update(
152:         int id,
153:         UpdateCommentRequest request,
154:         CancellationToken cancellationToken)
155:     {
156:         var comment = await GetCommentOrThrow(
157:             id,
158:             includeUser: true,
159:             cancellationToken: cancellationToken);
160:
161:         var currentUser = await GetCurrentUser(
162:             cancellationToken);
163:
164:         AuthorizationHelper.EnsureOwnerOrAdmin(
165:             comment.UserId,
166:             currentUser);
167:
168:         Context.Entry(comment)
169:             .Property(c => c.Version)
170:             .OriginalValue = request.Version;
171:
172:         comment.Content = request.Content.Trim();
173:
174:         _activityLogService.Add(
175:             action: "Update",
176:             entityType: "Comment",
177:             entityId: comment.Id,
178:             description: $"Updated comment {comment.Id}");
179:
180:         await Context.SaveChangesAsync(
181:             cancellationToken);
182:
183:         return CommentMapper.ToCommentResponse(comment);
184:     }
