<file path="Middleware/ExceptionMiddleware.cs">
 1: using System.Text.Json;
 2: using Helpdesk.Exceptions;
 3: using Microsoft.EntityFrameworkCore;
 4:
 5: namespace Helpdesk.Middleware;
 6:
 7: public class ExceptionMiddleware
 8: {
 9:     private readonly RequestDelegate _next;
10:
11:     public ExceptionMiddleware(RequestDelegate next)
12:     {
13:         _next = next;
14:     }
15:
16:     public async Task InvokeAsync(HttpContext context)
17:     {
18:         try
19:         {
20:             await _next(context);
21:         }
22:         catch (ValidationException ex)
23:         {
24:             context.Response.StatusCode = ex.StatusCode;
25:
26:             await context.Response.WriteAsJsonAsync(new
27:             {
28:                 message = ex.Message,
29:                 errors = ex.Errors
30:             });
31:         }
32:         catch (AppException ex)
33:         {
34:             context.Response.StatusCode = ex.StatusCode;
35:             context.Response.ContentType = "application/json";
36:
37:             await context.Response.WriteAsync(JsonSerializer.Serialize(new
38:             {
39:                 message = ex.Message
40:             }));
41:         }
42:         catch (DbUpdateConcurrencyException)
